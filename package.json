{
  "name": "it-support-service",
  "version": "0.1.0",
  "private": true,
  "description": "A small service for IT support requests.",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "oxlint --deny-warnings src test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "submit": "node scripts/submit.mjs"
  },
  "dependencies": {
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fflate": "0.8.3",
    "oxlint": "1.93.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
